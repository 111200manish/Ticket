<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WorkDesk - Company Helpdesk</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

body{
    font-family:Arial,Segoe UI,sans-serif;
    background:#f4f6fa;
    color:#182235;
}

.sidebar{
    position:fixed;
    left:0;
    top:0;
    bottom:0;
    width:235px;
    background:#111827;
    color:#fff;
    padding:25px 15px;
}

.logo{
    font-size:23px;
    font-weight:800;
    margin:0 10px 35px;
}

.logo span{color:#6382ff}

.menu-title{
    color:#758198;
    font-size:10px;
    text-transform:uppercase;
    margin:0 10px 10px;
}

.menu{
    list-style:none;
}

.menu li{
    padding:13px 12px;
    margin:4px 0;
    color:#a8b1c1;
    border-radius:8px;
    cursor:pointer;
    font-size:14px;
}

.menu li:hover,
.menu li.active{
    background:#202b40;
    color:#fff;
}

.main{
    margin-left:235px;
    min-height:100vh;
}

.topbar{
    height:70px;
    background:#fff;
    border-bottom:1px solid #e5e9f0;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 30px;
}

.search{
    width:390px;
}

.search input{
    width:100%;
    border:1px solid #e1e6ef;
    padding:11px 14px;
    border-radius:8px;
    outline:none;
}

.profile{
    display:flex;
    align-items:center;
    gap:10px;
}

.avatar{
    width:38px;
    height:38px;
    background:#e8edff;
    color:#4164d8;
    border-radius:50%;
    display:grid;
    place-items:center;
    font-weight:bold;
}

.profile small{
    color:#8791a2;
}

.content{
    padding:30px;
}

.page-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:24px;
}

.page-head h1{
    font-size:25px;
}

.page-head p{
    color:#8791a2;
    font-size:13px;
    margin-top:6px;
}

button{
    cursor:pointer;
}

.primary{
    border:0;
    background:#3867f5;
    color:white;
    padding:11px 17px;
    border-radius:8px;
    font-weight:bold;
}

.primary:hover{
    background:#2e57d8;
}

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:16px;
    margin-bottom:24px;
}

.stat{
    background:white;
    border:1px solid #e5e9f0;
    border-radius:11px;
    padding:20px;
}

.stat-label{
    color:#8791a2;
    font-size:12px;
}

.stat-number{
    font-size:29px;
    font-weight:800;
    margin-top:10px;
}

.panel{
    background:#fff;
    border:1px solid #e5e9f0;
    border-radius:11px;
    overflow:hidden;
}

.panel-head{
    padding:17px 20px;
    border-bottom:1px solid #e5e9f0;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.panel-head h2{
    font-size:16px;
}

.table-wrap{
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
}

th{
    text-align:left;
    padding:13px 18px;
    background:#fafbfd;
    color:#8791a2;
    font-size:10px;
    text-transform:uppercase;
}

td{
    padding:15px 18px;
    border-top:1px solid #e8ebf0;
    font-size:12px;
}

.ticket-row{
    cursor:pointer;
}

.ticket-row:hover td{
    background:#f8faff;
}

.ticket-id{
    color:#3867f5;
    font-weight:bold;
}

.ticket-title{
    font-weight:bold;
}

.ticket-sub{
    color:#8791a2;
    font-size:10px;
    margin-top:4px;
}

.person{
    display:flex;
    align-items:center;
    gap:8px;
}

.small-avatar{
    width:29px;
    height:29px;
    background:#edf0f6;
    border-radius:50%;
    display:grid;
    place-items:center;
    color:#59657a;
    font-size:9px;
    font-weight:bold;
}

.badge{
    display:inline-block;
    padding:5px 9px;
    border-radius:20px;
    font-size:10px;
    font-weight:bold;
}

.open{background:#eef2ff;color:#3867f5}
.progress{background:#fff5df;color:#d68b15}
.pending{background:#f1edff;color:#7958d9}
.resolved{background:#e8f8f2;color:#149866}
.high{background:#fff0f1;color:#df4d5b}
.medium{background:#fff5df;color:#d68b15}
.low{background:#e8f8f2;color:#149866}

.hidden{display:none!important}

.filters{
    display:flex;
    gap:8px;
}

select{
    border:1px solid #e1e6ef;
    padding:8px 10px;
    border-radius:7px;
    background:#fff;
    outline:none;
}

.detail-grid{
    display:grid;
    grid-template-columns:1.6fr .8fr;
    gap:18px;
}

.detail-panel{
    background:#fff;
    border:1px solid #e5e9f0;
    border-radius:11px;
    padding:22px;
    margin-bottom:18px;
}

.back{
    border:0;
    background:none;
    color:#3867f5;
    margin-bottom:18px;
    font-weight:bold;
}

.detail-id{
    color:#3867f5;
    font-size:12px;
    font-weight:bold;
}

.detail-title{
    font-size:21px;
    font-weight:bold;
    margin-top:6px;
}

.problem{
    margin-top:20px;
    padding-top:18px;
    border-top:1px solid #e5e9f0;
    color:#5d687b;
    line-height:1.7;
    font-size:13px;
}

.info-row{
    display:flex;
    justify-content:space-between;
    padding:13px 0;
    border-bottom:1px solid #e5e9f0;
    font-size:12px;
}

.info-row:last-child{
    border:0;
}

.info-row span:first-child{
    color:#8791a2;
}

.comments{
    margin-top:10px;
}

.comment{
    display:flex;
    gap:10px;
    padding:15px 0;
    border-bottom:1px solid #e5e9f0;
}

.comment-avatar{
    width:34px;
    height:34px;
    border-radius:50%;
    background:#e8edff;
    color:#4164d8;
    display:grid;
    place-items:center;
    font-size:10px;
    font-weight:bold;
    flex-shrink:0;
}

.comment-name{
    font-weight:bold;
    font-size:12px;
}

.comment-text{
    margin-top:5px;
    color:#5d687b;
    font-size:12px;
    line-height:1.5;
}

textarea{
    width:100%;
    min-height:90px;
    resize:vertical;
    border:1px solid #e1e6ef;
    border-radius:8px;
    padding:12px;
    outline:none;
    font-family:inherit;
    margin-top:15px;
}

.reply{
    text-align:right;
    margin-top:8px;
}

.modal-bg{
    position:fixed;
    inset:0;
    background:rgba(15,23,42,.5);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:100;
}

.modal{
    background:#fff;
    width:500px;
    max-width:calc(100% - 25px);
    border-radius:12px;
    padding:24px;
}

.modal-head{
    display:flex;
    justify-content:space-between;
    margin-bottom:20px;
}

.close{
    border:0;
    background:none;
    font-size:24px;
}

.form-group{
    margin-bottom:14px;
}

.form-group label{
    display:block;
    font-size:11px;
    font-weight:bold;
    margin-bottom:6px;
}

.form-group input,
.form-group select,
.form-group textarea{
    margin:0;
    width:100%;
    border:1px solid #e1e6ef;
    padding:10px;
    border-radius:7px;
}

.modal-actions{
    display:flex;
    justify-content:flex-end;
    gap:8px;
    margin-top:18px;
}

.cancel{
    border:1px solid #e1e6ef;
    background:#fff;
    padding:10px 15px;
    border-radius:7px;
}

.toast{
    position:fixed;
    right:25px;
    bottom:25px;
    background:#172033;
    color:#fff;
    padding:13px 18px;
    border-radius:8px;
    opacity:0;
    transform:translateY(20px);
    transition:.25s;
    z-index:200;
    font-size:12px;
}

.toast.show{
    opacity:1;
    transform:translateY(0);
}

@media(max-width:1000px){
    .stats{grid-template-columns:repeat(2,1fr)}
    .detail-grid{grid-template-columns:1fr}
}

@media(max-width:700px){
    .sidebar{
        position:static;
        width:100%;
    }

    .main{
        margin-left:0;
    }

    .menu{
        display:flex;
        overflow:auto;
    }

    .menu li{
        white-space:nowrap;
    }

    .topbar{
        padding:0 15px;
    }

    .search{
        width:55%;
    }

    .content{
        padding:18px;
    }

    .stats{
        grid-template-columns:1fr;
    }
}
</style>

</head>

