    localStorage.setItem(
        "workdesk_tickets",
        JSON.stringify(tickets)
    );

}


/* =========================================
   PAGE NAVIGATION
========================================= */

function showPage(page,element){

    document
        .querySelectorAll(".page")
        .forEach(p=>p.classList.add("hidden"));

    document
        .getElementById(page)
        .classList.remove("hidden");

    document
        .querySelectorAll(".menu li")
        .forEach(li=>li.classList.remove("active"));

    if(element){
        element.classList.add("active");
    }

    renderAll();

}


/* =========================================
   RENDER EVERYTHING
========================================= */

function renderAll(){

    renderDashboard();

    renderAllTickets();

    renderMyTickets();

    renderStatus("Open","openTable");

    renderStatus("In Progress","progressTable");

    renderStatus("Pending","pendingTable");

    renderStatus("Resolved","resolvedTable");

    updateCounters();

}


/* =========================================
   FILTER SEARCH
========================================= */

function matchesSearch(ticket){

    const input =
        document.getElementById("search");

    if(!input) return true;

    const search =
        input.value.toLowerCase().trim();

    if(!search) return true;

    return (

        ticket.id.toLowerCase().includes(search) ||
        ticket.user.toLowerCase().includes(search) ||
        ticket.subject.toLowerCase().includes(search) ||
        ticket.problem.toLowerCase().includes(search) ||
        ticket.department.toLowerCase().includes(search)

    );

}


/* =========================================
   ROW CREATOR
========================================= */

function createRow(ticket,full=false){

    const tr =
        document.createElement("tr");

    tr.className="ticket-row";

    tr.onclick=()=>{
        openTicket(ticket.id);
    };


    const initials =
        ticket.user
        .split(" ")
        .map(x=>x[0])
        .join("")
        .substring(0,2)
        .toUpperCase();


    const priorityClass =
        ticket.priority==="High"
        ?"high"
        :ticket.priority==="Medium"
        ?"medium"
        :"low";


    const statusClass =
        ticket.status==="Open"
        ?"open"
        :ticket.status==="In Progress"
        ?"progress"
        :ticket.status==="Pending"
        ?"pending"
        :"resolved";


    if(full){

        tr.innerHTML=`

        <td class="ticket-id">${esc(ticket.id)}</td>

        <td>
            <div class="person">
                <div class="small-avatar">
                    ${esc(initials)}
                </div>
                ${esc(ticket.user)}
            </div>
        </td>

        <td class="ticket-title">
            ${esc(ticket.subject)}
        </td>

        <td>
            ${esc(ticket.problem)}
        </td>

        <td>${esc(ticket.department)}</td>

        <td>
            <span class="badge ${priorityClass}">
                ${esc(ticket.priority)}
            </span>
        </td>

        <td>
            <span class="badge ${statusClass}">
                ${esc(ticket.status)}
            </span>
        </td>

        `;

    }else{

        tr.innerHTML=`

        <td class="ticket-id">${esc(ticket.id)}</td>

        <td>
            <div class="person">
                <div class="small-avatar">
                    ${esc(initials)}
                </div>
                ${esc(ticket.user)}
            </div>
        </td>

        <td class="ticket-title">
            ${esc(ticket.subject)}
        </td>

        <td>
            ${esc(ticket.problem)}
        </td>

        <td>
            <span class="badge ${priorityClass}">
                ${esc(ticket.priority)}
            </span>
        </td>

        <td>
            <span class="badge ${statusClass}">
                ${esc(ticket.status)}
            </span>
        </td>

        `;

    }

    return tr;

}


/* =========================================
   DASHBOARD
========================================= */

function renderDashboard(){

    const tbody =
        document.getElementById("dashboardTable");

    if(!tbody) return;

    tbody.innerHTML="";

    Object.values(tickets)
        .slice(-8)
        .reverse()
        .forEach(ticket=>{

            if(matchesSearch(ticket)){

                tbody.appendChild(
                    createRow(ticket)
                );

            }

        });

}


/* =========================================
   ALL TICKETS
========================================= */

function renderAllTickets(){

    const tbody =
        document.getElementById("allTable");

    if(!tbody) return;

    tbody.innerHTML="";

    const status =
        document.getElementById("allStatus")?.value
        || "all";

    const priority =
        document.getElementById("allPriority")?.value
        || "all";


    Object.values(tickets).forEach(ticket=>{

        if(!matchesSearch(ticket)) return;

        if(
            status!=="all" &&
            ticket.status!==status
        ) return;

        if(
            priority!=="all" &&
            ticket.priority!==priority
        ) return;


        tbody.appendChild(
            createRow(ticket,true)
        );

    });

}


/* =========================================
   MY TICKETS
========================================= */

function renderMyTickets(){

    const tbody =
        document.getElementById("myTable");

    if(!tbody) return;

    tbody.innerHTML="";


    Object.values(tickets).forEach(ticket=>{

        /*
            IMPORTANT:
            Resolved tickets My Tickets mein nahi.
        */

        if(ticket.assignee!=="Rahul") return;

        if(ticket.status==="Resolved") return;

        if(!matchesSearch(ticket)) return;


        tbody.appendChild(
            createRow(ticket)
        );

    });

}


/* =========================================
   STATUS LIST
========================================= */

function renderStatus(status,id){

    const tbody =
        document.getElementById(id);

    if(!tbody) return;

    tbody.innerHTML="";


    Object.values(tickets).forEach(ticket=>{

        if(ticket.status!==status) return;

        if(!matchesSearch(ticket)) return;

        tbody.appendChild(
            createRow(ticket)
        );

    });

}


/* =========================================
   COUNTERS
========================================= */

function updateCounters(){

    const values =
        Object.values(tickets);

    document.getElementById("countOpen")
        .textContent =
        values.filter(x=>x.status==="Open").length;

    document.getElementById("countProgress")
        .textContent =
        values.filter(x=>x.status==="In Progress").length;

    document.getElementById("countPending")
        .textContent =
        values.filter(x=>x.status==="Pending").length;

    document.getElementById("countResolved")
        .textContent =
        values.filter(x=>x.status==="Resolved").length;

}


/* =========================================
   OPEN TICKET
========================================= */

function openTicket(id){

    const numeric =
        parseInt(
            String(id).replace(/\D/g,"")
        );

    const ticket =
        tickets[numeric];

    if(!ticket){

        showToast("Ticket not found");

        return;

    }


    currentTicket=numeric;


    document
        .querySelectorAll(".page")
        .forEach(p=>p.classList.add("hidden"));


    document
        .getElementById("details")
        .classList.remove("hidden");


    document.getElementById("detailId")
        .textContent=ticket.id;

    document.getElementById("detailTitle")
        .textContent=ticket.subject;

    document.getElementById("detailProblem")
        .textContent=ticket.problem;

    document.getElementById("detailUser")
        .textContent=ticket.user;

    document.getElementById("detailDepartment")
        .textContent=ticket.department;

    document.getElementById("detailPriority")
        .value=ticket.priority;

    document.getElementById("detailStatus")
        .value=ticket.status;

    document.getElementById("detailAssignee")
        .value=ticket.assignee;


    renderComments(ticket);

}


/* =========================================
   UPDATE CURRENT TICKET
========================================= */

function updateCurrentTicket(){

    if(currentTicket===null) return;


    const ticket =
        tickets[currentTicket];


    ticket.priority =
        document.getElementById(
            "detailPriority"
        ).value;


    ticket.assignee =
        document.getElementById(
            "detailAssignee"
        ).value;


    const newStatus =
        document.getElementById(
            "detailStatus"
        ).value;


    ticket.status=newStatus;


    saveTickets();

    renderAll();

    showToast(
        `${ticket.id} status updated to ${newStatus}`
    );

}


/* =========================================
   MARK RESOLVED
========================================= */

function markResolved(){

    if(currentTicket===null) return;


    tickets[currentTicket].status="Resolved";


    document.getElementById(
        "detailStatus"
    ).value="Resolved";


    saveTickets();

    renderAll();

    showToast(
        "Ticket moved to Resolved"
    );

}


/* =========================================
   BACK
========================================= */

function backToAll(){

    showPage("all",null);

}


/* =========================================
   COMMENTS
========================================= */

function renderComments(ticket){

    const box =
        document.getElementById("comments");

    box.innerHTML="";


    if(!ticket.comments ||
       ticket.comments.length===0){

        box.innerHTML=`
            <div style="
                color:#8791a2;
                font-size:12px;
                padding:15px 0;
            ">
                No comments yet.
            </div>
        `;

        return;

    }


    ticket.comments.forEach(comment=>{

        const div =
            document.createElement("div");

        div.className="comment";

        div.innerHTML=`

            <div class="comment-avatar">
                ${esc(comment.initials)}
            </div>

            <div>

                <div class="comment-name">
                    ${esc(comment.name)}
                </div>

                <div class="comment-text">
                    ${esc(comment.text)}
                </div>

            </div>
        `;

        box.appendChild(div);

    });

}


/* =========================================
   SEND REPLY
========================================= */

function sendReply(){

    if(currentTicket===null) return;


    const textarea =
        document.getElementById("replyText");


    const text =
        textarea.value.trim();


    if(!text){

        showToast(
            "Please write a reply first"
        );

        return;

    }


    if(!tickets[currentTicket].comments){

        tickets[currentTicket].comments=[];

    }


    tickets[currentTicket].comments.push({

        name:"Manish Kumar",

        initials:"RK",

        text:text

    });


    textarea.value="";


    saveTickets();

    renderComments(
        tickets[currentTicket]
    );


    showToast("Reply added successfully");

}


/* =========================================
   NEW TICKET
========================================= */

function openModal(){

    document.getElementById(
        "modal"
    ).style.display="flex";

}


function closeModal(){

    document.getElementById(
        "modal"
    ).style.display="none";

}


function createTicket(){

    const user =
        document.getElementById(
            "newUser"
        ).value.trim();


    const subject =
        document.getElementById(
            "newSubject"
        ).value.trim();


    const problem =
        document.getElementById(
            "newProblem"
        ).value.trim();


    const department =
        document.getElementById(
            "newDepartment"
        ).value;


    const priority =
        document.getElementById(
            "newPriority"
        ).value;


    if(!user || !subject || !problem){

        showToast(
            "Please fill all fields"
        );

        return;

    }


    const ids =
        Object.keys(tickets)
        .map(Number);


    const id =
        Math.max(...ids)+1;


    tickets[id]={

        id:"#REQ-"+id,

        user:user,

        subject:subject,

        problem:problem,

        department:department,

        priority:priority,

        status:"Open",

        assignee:"Rahul",

        comments:[]

    };


    saveTickets();

    closeModal();

    document.getElementById(
        "newUser"
    ).value="";

    document.getElementById(
        "newSubject"
    ).value="";

    document.getElementById(
        "newProblem"
    ).value="";


    renderAll();


    showToast(
        "New ticket created successfully"
    );

}


/* =========================================
   ESCAPE HTML
========================================= */

function esc(value){

    const div =
        document.createElement("div");

    div.textContent =
        String(value ?? "");

    return div.innerHTML;

}


/* =========================================
   TOAST
========================================= */

function showToast(message){

    const toast =
        document.getElementById("toast");

    toast.textContent=message;

    toast.classList.add("show");


    setTimeout(()=>{

        toast.classList.remove("show");

    },2500);

}


/* =========================================
   INITIALIZE
========================================= */

renderAll();

</script>

